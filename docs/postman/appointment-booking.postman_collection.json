{
  "info": {
    "name": "Appointment Booking System",
    "description": "Manual test collection for booking-api (:18080) and capacity-api (:18081).\n\nRun `make up` first.\n\nThe **BUG-1 Regression** folder is ordered and scripted \u2014 run it with the Collection Runner. It orphans a reservation, releases it, and asserts the seat came back exactly once.\n\nNote: this branch fixes BUG-1 only. A retry with the same Idempotency-Key still creates a duplicate booking (INC-1) \u2014 that is a separate defect.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "bookingUrl",
      "value": "http://localhost:18080"
    },
    {
      "key": "capacityUrl",
      "value": "http://localhost:18081"
    },
    {
      "key": "userId",
      "value": "user-postman-001"
    },
    {
      "key": "slotId",
      "value": "slot-munich-0900"
    },
    {
      "key": "scarceSlotId",
      "value": "slot-berlin-0900"
    },
    {
      "key": "idempotencyKey",
      "value": "idem-manual-001"
    },
    {
      "key": "operationId",
      "value": "op-manual-001"
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "availableBefore",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "booking-api health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bookingUrl}}/health",
              "host": [
                "{{bookingUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "capacity-api health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{capacityUrl}}/health",
              "host": [
                "{{capacityUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bookings (public API v1)",
      "item": [
        {
          "name": "Create booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-ID",
                "value": "{{userId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot_id\": \"{{slotId}}\"\n}"
            },
            "url": {
              "raw": "{{bookingUrl}}/api/v1/bookings",
              "host": [
                "{{bookingUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            },
            "description": "Creates a booking and reserves a seat. Note: this branch does not deduplicate on Idempotency-Key (INC-1), so sending this twice creates two bookings."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', body.id);",
                  "pm.test('status is a v1 value the mobile client accepts', () => {",
                  "    pm.expect(body.status).to.be.oneOf(['scheduled', 'completed']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create booking (inject post-commit failure)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-ID",
                "value": "{{userId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "X-Challenge-Fault",
                "value": "post-commit"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot_id\": \"{{slotId}}\"\n}"
            },
            "url": {
              "raw": "{{bookingUrl}}/api/v1/bookings",
              "host": [
                "{{bookingUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            },
            "description": "Commits the booking, then fails \u2014 the client sees a 500 and retries. Requires CHALLENGE_MODE=true."
          }
        },
        {
          "name": "Create booking (missing X-User-ID)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot_id\": \"{{slotId}}\"\n}"
            },
            "url": {
              "raw": "{{bookingUrl}}/api/v1/bookings",
              "host": [
                "{{bookingUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get booking by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{bookingUrl}}/api/v1/bookings/{{bookingId}}",
              "host": [
                "{{bookingUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "{{bookingId}}"
              ]
            }
          }
        },
        {
          "name": "List my bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{bookingUrl}}/api/v1/bookings",
              "host": [
                "{{bookingUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Capacity (internal API)",
      "item": [
        {
          "name": "Get slot",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{capacityUrl}}/internal/v1/slots/{{slotId}}",
              "host": [
                "{{capacityUrl}}"
              ],
              "path": [
                "internal",
                "v1",
                "slots",
                "{{slotId}}"
              ]
            },
            "description": "Seeded slots: slot-munich-0900 (30), slot-munich-1000 (20), slot-berlin-0900 (1)."
          }
        },
        {
          "name": "Create reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation_id\": \"{{operationId}}\",\n  \"slot_id\": \"{{slotId}}\"\n}"
            },
            "url": {
              "raw": "{{capacityUrl}}/internal/v1/reservations",
              "host": [
                "{{capacityUrl}}"
              ],
              "path": [
                "internal",
                "v1",
                "reservations"
              ]
            },
            "description": "Send twice with the same operation_id \u2014 capacity must only be consumed once."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "List reservations by operation_id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{capacityUrl}}/internal/v1/reservations?operation_id={{operationId}}",
              "host": [
                "{{capacityUrl}}"
              ],
              "path": [
                "internal",
                "v1",
                "reservations"
              ],
              "query": [
                {
                  "key": "operation_id",
                  "value": "{{operationId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('at most one reservation per operation_id', () => {",
                  "    pm.expect(pm.response.json().length).to.be.at.most(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Exhaust scarce slot (capacity 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation_id\": \"op-scarce-{{$timestamp}}\",\n  \"slot_id\": \"{{scarceSlotId}}\"\n}"
            },
            "url": {
              "raw": "{{capacityUrl}}/internal/v1/reservations",
              "host": [
                "{{capacityUrl}}"
              ],
              "path": [
                "internal",
                "v1",
                "reservations"
              ]
            },
            "description": "First call 201, second 409. Each call uses a fresh operation_id, so this tests capacity, not idempotency."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 or 409 once exhausted', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Release reservation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{capacityUrl}}/internal/v1/reservations/{{operationId}}/release",
              "host": [
                "{{capacityUrl}}"
              ],
              "path": [
                "internal",
                "v1",
                "reservations",
                "{{operationId}}",
                "release"
              ]
            },
            "description": "Idempotent. Returns 200 even for an unknown operation_id -- a compensating call must not fail because its subject is gone."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm reservation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{capacityUrl}}/internal/v1/reservations/{{operationId}}/confirm",
              "host": [
                "{{capacityUrl}}"
              ],
              "path": [
                "internal",
                "v1",
                "reservations",
                "{{operationId}}",
                "confirm"
              ]
            },
            "description": "Pins the seat permanently. 404 if unknown, 409 if already released."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "BUG-1 Regression",
      "description": "Ordered -- run with the Collection Runner. An orphaned reservation (booking-api reserved, then failed) must not hold a seat forever.",
      "item": [
        {
          "name": "1. Capacity before",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('operationId', 'op-bug1-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('availableBefore', pm.response.json().available_capacity);",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{capacityUrl}}/internal/v1/slots/{{slotId}}",
              "host": [
                "{{capacityUrl}}"
              ],
              "path": [
                "internal",
                "v1",
                "slots",
                "{{slotId}}"
              ]
            }
          }
        },
        {
          "name": "2. Orphan a reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{capacityUrl}}/internal/v1/reservations",
              "host": [
                "{{capacityUrl}}"
              ],
              "path": [
                "internal",
                "v1",
                "reservations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation_id\": \"{{operationId}}\",\n  \"slot_id\": \"{{slotId}}\"\n}"
            },
            "description": "Simulates booking-api reserving capacity and then dying before it commits its booking."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Seat is held",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const before = Number(pm.collectionVariables.get('availableBefore'));",
                  "pm.test('capacity dropped by 1', () => {",
                  "    pm.expect(pm.response.json().available_capacity).to.eql(before - 1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{capacityUrl}}/internal/v1/slots/{{slotId}}",
              "host": [
                "{{capacityUrl}}"
              ],
              "path": [
                "internal",
                "v1",
                "slots",
                "{{slotId}}"
              ]
            }
          }
        },
        {
          "name": "4. Release it",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{capacityUrl}}/internal/v1/reservations/{{operationId}}/release",
              "host": [
                "{{capacityUrl}}"
              ],
              "path": [
                "internal",
                "v1",
                "reservations",
                "{{operationId}}",
                "release"
              ]
            }
          }
        },
        {
          "name": "5. Seat came back",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const before = Number(pm.collectionVariables.get('availableBefore'));",
                  "const slot = pm.response.json();",
                  "pm.test('BUG-1: released capacity is available again', () => {",
                  "    pm.expect(slot.available_capacity).to.eql(before);",
                  "});",
                  "pm.test('and it is not double-counted', () => {",
                  "    pm.expect(slot.available_capacity).to.be.at.most(slot.total_capacity);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{capacityUrl}}/internal/v1/slots/{{slotId}}",
              "host": [
                "{{capacityUrl}}"
              ],
              "path": [
                "internal",
                "v1",
                "slots",
                "{{slotId}}"
              ]
            }
          }
        },
        {
          "name": "6. Release again is a no-op",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK -- idempotent', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{capacityUrl}}/internal/v1/reservations/{{operationId}}/release",
              "host": [
                "{{capacityUrl}}"
              ],
              "path": [
                "internal",
                "v1",
                "reservations",
                "{{operationId}}",
                "release"
              ]
            }
          }
        }
      ]
    }
  ]
}